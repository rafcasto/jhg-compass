rules_version = '2';
// JobHacker Compass — Firestore security rules
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }

    // ---- per-user data: profile + all CRM/tracker/settings subcollections ----
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{sub=**} { allow read, write: if isOwner(uid); }
    }

    // ---- access grants: owner reads own; writes Admin SDK only ----
    match /accessGrants/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // ---- editable UI content: public read (just presentational copy, no secrets)
    //      so the signed-out auth screens reflect admin edits too; admin write only ----
    match /config/content {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- public acquisition funnel (landing / quiz / thank-you copy + questions):
    //      public read so the signed-out funnel pages reflect admin edits; admin write ----
    match /config/funnel {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- admin config (paywall/email copy): signed-in read; admin write ----
    match /config/{doc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- registration links: server-only (Admin SDK) ----
    match /registrationLinks/{token} { allow read, write: if false; }

    // default deny
    match /{document=**} { allow read, write: if false; }
  }
}
