# ============ Firebase (AUTH + APP DATA / Firestore) ============
# Public client config — safe to expose to the browser.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK — SERVER ONLY. Base64 of the service account JSON.
# Firebase console > Project Settings > Service Accounts > Generate new private key,
# then: base64 -i serviceAccount.json | pbcopy
FIREBASE_SERVICE_ACCOUNT_B64=

# ============ Supabase (EVENT LOGS ONLY) ============
SUPABASE_URL=
SUPABASE_SECRET_KEY=          # server only — never expose

# ============ Access webhook ============
COMPASS_WEBHOOK_SECRET=       # shared secret your lead-magnet/payment page sends

# ============ App URL (for links in emails) ============
# Where /set-password lives. Optional on Vercel (VERCEL_PROJECT_PRODUCTION_URL is
# used automatically); set this for a custom domain or non-Vercel host.
APP_URL=

# ============ Resend (transactional email) ============
RESEND_API_KEY=
RESEND_FROM="JobHacker Compass <compass@jobhackers.global>"

# ============ Kit (marketing email) ============
KIT_API_KEY=
# Sequence new registrants are enrolled into on signup.
# Defaults to the "JHG Compass Onboarding — Get Your Bearings" sequence.
KIT_COMPASS_SEQUENCE_ID=2830637

# ---- Ghost (Compass reading rail) — Content API is read-only but stays server-side ----
GHOST_CONTENT_API_URL=https://your-ghost-site.example
GHOST_CONTENT_API_KEY=

# ---- Google Analytics (Admin → Analytics → Pirate metrics, Awareness layer) ----
# Optional. With GA4_PROPERTY_ID set, the FO dashboard pulls sessions, channels,
# countries, landing pages and a daily trend from the GA4 Data API.
GA4_PROPERTY_ID=              # numeric property id (GA → Admin → Property settings), NOT the G-… measurement id
GA4_SERVICE_ACCOUNT_B64=      # optional — defaults to FIREBASE_SERVICE_ACCOUNT_B64; grant that account Viewer on the property
                              # and enable "Google Analytics Data API" on the GCP project

# ============ Agents (career-ops on the Raspberry Pi) ============
# Upstash Redis DB "JHG-Compass" — the queue the Pi worker polls. Server only.
# The same two values go in the Pi's ~/careerops-worker/.env. Rotate if ever exposed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Google Drive folder the Pi worker uploads generated PDFs to (one subfolder per member).
# The site only READS from it to stream downloads, using the Firebase service account —
# share the folder with that account as Editor and enable the Drive API on the project.
GOOGLE_DRIVE_FOLDER_ID=

# ============ The Claude engine (the AI coach on JobHacking and Compass; docs/CAREER_OPS_CLAUDE.md) ============
# Server only. One key for every Claude call the site makes; the Pi keeps its own.
ANTHROPIC_API_KEY=
# Only if the key is an organisation-level key in an org that requires a workspace
# ("This API key is not scoped to a workspace"): the workspace id from console.anthropic.com
# → Settings → Workspaces. A workspace-scoped key needs no header — leave this empty.
ANTHROPIC_WORKSPACE_ID=
# QStash (Upstash) — the push queue that calls /api/engine/run. Without these, engine jobs run
# inline in the request (local dev only). APP_URL must be set for the callback to reach you.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Sourcing by API (docs/SEARCH_TO_API_ASSESSMENT_2026-11-17.md, docs/AGENTIC_PIPELINE_PLAN.md §5). With any of these
# set, the postings job reads the aggregators instead of searching with the model; without them it searches as before.
# FREE FIRST: Careerjet is free and answers every query; a Google route (JSearch or SerpApi) is metered and runs only to fill
# a gap, at most SOURCING_METERED_MAX requests a run (default 6; 0 = never). Every query's rows are cached 24 h, shared by every
# member, so the same question is paid for once. Free allowances: Careerjet unmetered · JSearch 200/month · SerpApi 100/month ·
# Adzuna 25/month (its free plan, read 2026-11-18 — metered and last in line here; a paid Adzuna plan makes it the primary again).
# Adzuna: developer.adzuna.com — one key covers NZ · AU · US · CA.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Careerjet: careerjet.com/partners — the affiliate id; AU · US · CA · NZ.
CAREERJET_AFFID=
# Google for Jobs — how Seek postings come in (NZ · AU). Two routes to the same data; set ONE. Metered either way, so it runs
# after the free sources (and only to fill a gap for the postings job; for every query in the companies job).
# JSearch (the cheaper; full job descriptions). Two doors to the same API — set the key and say which door it opens:
#   RapidAPI marketplace key (subscribe to the JSearch API there, Basic is free)  → JSEARCH_PROVIDER=rapidapi (default)
#   OpenWeb Ninja's own platform, app.openwebninja.com                             → JSEARCH_PROVIDER=openwebninja
JSEARCH_API_KEY=
JSEARCH_PROVIDER=rapidapi
# Only if RapidAPI answers 404 "Endpoint '/search' does not exist": the exact URL its code snippet shows for the Search endpoint
# (listings move hosts and paths). The host header follows it. Leave empty otherwise.
JSEARCH_BASE_URL=
# SerpApi google_jobs (~$75/mo for 5k): used only when JSEARCH_API_KEY is not set.
SERPAPI_KEY=
# The companies job's model proposal (industry leaders, competitors, suppliers — one call with web search). "auto" runs it
# only when the job boards leave the list short of 40; "off" never — the 40 come from the boards' APIs alone.
COMPANIES_PROPOSAL=auto
SOURCING_METERED_MAX=6
